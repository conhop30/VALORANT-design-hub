{
  "name": "valorant-agent-designer",
  "version": "1.1.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.22",
    "expo-audio": "~57.0.5",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.18",
    "expo-linear-gradient": "~57.0.2",
    "expo-sharing": "~57.0.19",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.5",
    "eas-cli": "^24.7.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch --coverage",
    "dev": "concurrently -n metro,tests -c blue,green \"npm:start\" \"npm:test:watch\"",
    "export:web": "expo export --platform web --output-dir dist",
    "electron": "npm run export:web && electron electron/main.js",
    "electron:build": "npm run export:web && electron-builder",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "release:android": "eas build --platform android --profile production"
  },
  "private": true,
  "build": {
    "appId": "com.valorantdesignhub.app",
    "productName": "VALORANT Design Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
